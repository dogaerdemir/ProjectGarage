                    <constraint firstItem="badge" firstAttribute="leading" secondItem="title" secondAttribute="leading" id="badge-leading"/>
                    <constraint firstItem="metadata" firstAttribute="leading" secondItem="title" secondAttribute="leading" id="metadata-leading"/>
                    <constraint firstItem="metadata" firstAttribute="bottom" secondItem="content" secondAttribute="bottom" constant="-12" id="metadata-bottom"/>
                    <constraint firstItem="menu" firstAttribute="centerY" secondItem="metadata" secondAttribute="centerY" id="menu-center-y"/>
                    <constraint firstAttribute="trailing" secondItem="menu" secondAttribute="trailing" id="menu-trailing"/>
                    <constraint firstItem="menu" firstAttribute="leading" relation="greaterThanOrEqual" secondItem="metadata" secondAttribute="trailing" constant="4" id="menu-after-metadata"/>
                    <constraint firstItem="metadata" firstAttribute="top" relation="greaterThanOrEqual" secondItem="badge" secondAttribute="bottom" constant="4" id="metadata-after-badge"/>
