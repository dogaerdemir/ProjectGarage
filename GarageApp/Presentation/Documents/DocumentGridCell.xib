                    </imageView>
                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Bakım Faturası" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" translatesAutoresizingMaskIntoConstraints="NO" id="title">
                        <rect key="frame" x="12" y="134" width="152" height="19"/>
                        <constraints><constraint firstAttribute="height" constant="19" id="title-height"/></constraints>
                        <fontDescription key="fontDescription" type="system" pointSize="15"/>
                    </label>
                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="751" verticalHuggingPriority="751" text="Bakım kaydına bağlı" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" translatesAutoresizingMaskIntoConstraints="NO" id="badge" customClass="DocumentBadgeLabel" customModule="GarageApp" customModuleProvider="target">
                        <rect key="frame" x="12" y="159" width="112" height="22"/>
                        <constraints>
                            <constraint firstAttribute="height" constant="22" id="badge-height"/>
                            <constraint firstAttribute="width" relation="lessThanOrEqual" constant="142" id="badge-max-width"/>
                        </constraints>
                        <fontDescription key="fontDescription" type="system" pointSize="11"/>
                    </label>
                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="12 Tem 2026" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" translatesAutoresizingMaskIntoConstraints="NO" id="metadata">
                        <rect key="frame" x="12" y="190" width="120" height="16"/>
                        <constraints><constraint firstAttribute="height" constant="16" id="metadata-height"/></constraints>
                        <fontDescription key="fontDescription" type="system" pointSize="12"/>
                    </label>
                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" id="menu">
                        <rect key="frame" x="136" y="180" width="40" height="36"/>
                        <constraints>
                            <constraint firstAttribute="width" constant="40" id="menu-width"/>
                            <constraint firstAttribute="height" constant="36" id="menu-height"/>
                        </constraints>
                        <state key="normal" image="ellipsis" catalog="system"/>
                    </button>
                </subviews>
                <constraints>
                    <constraint firstItem="thumbnail" firstAttribute="top" secondItem="content" secondAttribute="top" constant="8" id="thumbnail-top"/>
                    <constraint firstItem="thumbnail" firstAttribute="leading" secondItem="content" secondAttribute="leading" constant="8" id="thumbnail-leading"/>
                    <constraint firstAttribute="trailing" secondItem="thumbnail" secondAttribute="trailing" constant="8" id="thumbnail-trailing"/>
                    <constraint firstItem="thumbnail" firstAttribute="height" constant="118" id="thumbnail-height"/>
                    <constraint firstItem="title" firstAttribute="top" secondItem="thumbnail" secondAttribute="bottom" constant="8" id="title-top"/>
                    <constraint firstItem="title" firstAttribute="leading" secondItem="content" secondAttribute="leading" constant="12" id="title-leading"/>
                    <constraint firstAttribute="trailing" secondItem="title" secondAttribute="trailing" constant="12" id="title-trailing"/>
