                                            <constraint firstAttribute="width" constant="30" id="icon-width"/>
                                            <constraint firstAttribute="height" constant="30" id="icon-height"/>
                                            <constraint firstItem="icon" firstAttribute="centerX" secondItem="icon-container" secondAttribute="centerX" id="icon-center-x"/>
                                            <constraint firstItem="icon" firstAttribute="centerY" secondItem="icon-container" secondAttribute="centerY" id="icon-center-y"/>
                                            <constraint firstItem="icon" firstAttribute="width" constant="17" id="image-width"/>
                                            <constraint firstItem="icon" firstAttribute="height" constant="17" id="image-height"/>
                                        </constraints>
