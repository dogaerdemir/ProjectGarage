<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="26000" targetRuntime="iOS.CocoaTouch" useAutolayout="YES" useTraitCollections="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies><plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="26000"/></dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="owner"/>
        <placeholder placeholderIdentifier="IBFirstResponder" id="first" customClass="UIResponder"/>
        <tableViewCell contentMode="scaleToFill" selectionStyle="none" reuseIdentifier="ToggleCell" rowHeight="66" id="cell" customClass="ToggleCell" customModule="GarageApp" customModuleProvider="target">
            <rect key="frame" x="0.0" y="0.0" width="393" height="66"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES"/>
            <tableViewCellContentView key="contentView" opaque="NO" clipsSubviews="YES" contentMode="center" tableViewCell="cell" id="content">
                <rect key="frame" x="0.0" y="0.0" width="393" height="66"/>
                <autoresizingMask key="autoresizingMask"/>
                <subviews>
                    <label opaque="NO" contentMode="left" text="Seçenek" numberOfLines="0" adjustsFontForContentSizeCategory="YES" translatesAutoresizingMaskIntoConstraints="NO" id="title"><fontDescription key="fontDescription" style="UICTFontTextStyleBody"/></label>
                    <switch opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="toggle"/>
                </subviews>
                <constraints>
                    <constraint firstItem="title" firstAttribute="leading" secondItem="content" secondAttribute="leading" constant="16" id="title-leading"/>
                    <constraint firstItem="title" firstAttribute="top" secondItem="content" secondAttribute="top" constant="14" id="title-top"/>
                    <constraint firstAttribute="bottom" secondItem="title" secondAttribute="bottom" constant="14" id="title-bottom"/>
                    <constraint firstItem="toggle" firstAttribute="leading" secondItem="title" secondAttribute="trailing" constant="12" id="toggle-leading"/>
                    <constraint firstAttribute="trailing" secondItem="toggle" secondAttribute="trailing" constant="16" id="toggle-trailing"/>
                    <constraint firstItem="toggle" firstAttribute="centerY" secondItem="content" secondAttribute="centerY" id="toggle-center"/>
                </constraints>
            </tableViewCellContentView>
            <connections><outlet property="fieldTitleLabel" destination="title" id="out-title"/><outlet property="toggle" destination="toggle" id="out-toggle"/></connections>
            <point key="canvasLocation" x="120" y="70"/>
        </tableViewCell>
    </objects>
</document>
