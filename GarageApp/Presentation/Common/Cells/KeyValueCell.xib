                    <constraint firstAttribute="trailing" secondItem="value" secondAttribute="trailing" constant="16" id="value-trailing"/>
                    <constraint firstAttribute="bottom" secondItem="value" secondAttribute="bottom" constant="12" id="value-bottom"/>
