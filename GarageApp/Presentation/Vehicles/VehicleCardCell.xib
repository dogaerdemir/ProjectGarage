                                    <constraint firstAttribute="width" constant="36" id="edit-width"/>
                                    <constraint firstAttribute="height" constant="36" id="edit-height"/>
                                </constraints>
                            </button>
                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" id="delete-button" customClass="CompactIconButton" customModule="GarageApp" customModuleProvider="target">
                                <rect key="frame" x="311" y="8" width="36" height="36"/>
