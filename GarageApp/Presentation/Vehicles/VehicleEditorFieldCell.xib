<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="26000" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="26000"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner"/>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <tableViewCell contentMode="scaleToFill" selectionStyle="none" indentationWidth="10" reuseIdentifier="VehicleEditorFieldCell" rowHeight="56" id="cell" customClass="VehicleEditorFieldCell" customModule="GarageApp" customModuleProvider="target">
            <rect key="frame" x="0.0" y="0.0" width="361" height="56"/>
            <autoresizingMask key="autoresizingMask"/>
            <tableViewCellContentView key="contentView" opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="center" tableViewCell="cell" id="content">
                <rect key="frame" x="0.0" y="0.0" width="361" height="56"/>
                <autoresizingMask key="autoresizingMask"/>
                <subviews>
                    <label opaque="NO" contentMode="left" text="Araç Adı" numberOfLines="2" translatesAutoresizingMaskIntoConstraints="NO" id="title">
                        <rect key="frame" x="14" y="18" width="112" height="20"/>
                        <constraints><constraint firstAttribute="width" constant="112" id="title-width"/></constraints>
                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                    </label>
                    <textField opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="left" contentVerticalAlignment="center" clearButtonMode="whileEditing" translatesAutoresizingMaskIntoConstraints="NO" id="text-field">
                        <rect key="frame" x="138" y="6" width="209" height="44"/>
                        <constraints><constraint firstAttribute="height" relation="greaterThanOrEqual" constant="44" id="text-height"/></constraints>
                        <fontDescription key="fontDescription" type="system" pointSize="15"/>
                    </textField>
                    <label opaque="NO" contentMode="left" text="Seçiniz" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="value">
                        <rect key="frame" x="138" y="18" width="181" height="20"/>
                        <fontDescription key="fontDescription" type="system" pointSize="15"/>
                    </label>
                    <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" translatesAutoresizingMaskIntoConstraints="NO" id="chevron">
                        <rect key="frame" x="333" y="21" width="14" height="14"/>
                        <constraints>
                            <constraint firstAttribute="width" constant="14" id="chevron-width"/>
                            <constraint firstAttribute="height" constant="14" id="chevron-height"/>
                        </constraints>
                    </imageView>
                </subviews>
                <constraints>
                    <constraint firstItem="title" firstAttribute="leading" secondItem="content" secondAttribute="leading" constant="14" id="title-leading"/>
                    <constraint firstItem="title" firstAttribute="centerY" secondItem="content" secondAttribute="centerY" id="title-y"/>
                    <constraint firstItem="title" firstAttribute="top" relation="greaterThanOrEqual" secondItem="content" secondAttribute="top" constant="8" id="title-top"/>
                    <constraint firstAttribute="bottom" relation="greaterThanOrEqual" secondItem="title" secondAttribute="bottom" constant="8" id="title-bottom"/>
                    <constraint firstItem="text-field" firstAttribute="leading" secondItem="title" secondAttribute="trailing" constant="12" id="text-leading"/>
                    <constraint firstAttribute="trailing" secondItem="text-field" secondAttribute="trailing" constant="14" id="text-trailing"/>
                    <constraint firstItem="text-field" firstAttribute="top" secondItem="content" secondAttribute="top" constant="6" id="text-top"/>
                    <constraint firstAttribute="bottom" secondItem="text-field" secondAttribute="bottom" constant="6" id="text-bottom"/>
                    <constraint firstItem="value" firstAttribute="leading" secondItem="title" secondAttribute="trailing" constant="12" id="value-leading"/>
                    <constraint firstItem="value" firstAttribute="centerY" secondItem="content" secondAttribute="centerY" id="value-y"/>
                    <constraint firstItem="value" firstAttribute="top" relation="greaterThanOrEqual" secondItem="content" secondAttribute="top" constant="8" id="value-top"/>
                    <constraint firstAttribute="bottom" relation="greaterThanOrEqual" secondItem="value" secondAttribute="bottom" constant="8" id="value-bottom"/>
                    <constraint firstItem="chevron" firstAttribute="leading" secondItem="value" secondAttribute="trailing" constant="8" id="chevron-leading"/>
                    <constraint firstAttribute="trailing" secondItem="chevron" secondAttribute="trailing" constant="14" id="chevron-trailing"/>
                    <constraint firstItem="chevron" firstAttribute="centerY" secondItem="content" secondAttribute="centerY" id="chevron-y"/>
                </constraints>
            </tableViewCellContentView>
            <connections>
                <outlet property="chevronImageView" destination="chevron" id="out-chevron"/>
                <outlet property="textField" destination="text-field" id="out-text-field"/>
                <outlet property="titleLabel" destination="title" id="out-title"/>
                <outlet property="valueLabel" destination="value" id="out-value"/>
