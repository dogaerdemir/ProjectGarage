                                                <stackView opaque="NO" contentMode="scaleToFill" alignment="center" spacing="14" translatesAutoresizingMaskIntoConstraints="NO" id="status-row">
                                                    <rect key="frame" x="16" y="16" width="329" height="56"/>
                                                    <subviews>
